<!DOCTYPE html>
<html lang="ca">
<head>
  {{> header}}
  <link rel="stylesheet" href="formularis.css">
  <title>Editar Pel·lícula</title>
</head>
<body>
  {{> menu}}

  <main class="container">
    <h1>Editar Pel·lícula (ID: {{movies.Id}})</h1>

    <form method="POST" action="/update" class="form-grid">
      <input type="hidden" name="table" value="movies">
      <input type="hidden" name="id" value="{{movies.Id}}">

      <label for="Titol">Titol</label>
      <input type="text" id="Titol" name="Titol" value="{{movies.Titol}}" required>

      <label for="Any">Any</label>
      <input type="number" id="Any" name="Any" value="{{movies.Any}}" required>
      
      <label for="Any">Actors</label>
      <input type="text" id="Actors" name="Actors" value="{{movies.Actors}}" required>
      

      <button type="submit">Desar canvis</button>
    </form>

    <hr>

    <form method="POST" action="/delete" onsubmit="return true;">
      <input type="hidden" name="table" value="movies">
      <input type="hidden" name="id" value="{{movies.Id}}">
      <button type="submit">🗑️ Esborrar pel·lícula</button>
    </form>

    <br>
    <a href="/movies?id={{movies.Id}}">Tornar a la fitxa</a>
  </main>

  {{> footer}}
</body>
</html>
